    "ValveControlDelegate.cpp",
    "WindowCoveringManager.cpp",
    "include/tv-callbacks.cpp",
    "include/tv-callbacks.h",
    "main-common.cpp",
  ]

  deps = [
    "${chip_root}/examples/all-clusters-app/all-clusters-common",
    "${chip_root}/examples/platform/linux:app-main",
    "${chip_root}/src/app:attribute-persistence",
    "${chip_root}/src/lib",
    "${chip_root}/third_party/jsoncpp",
  ]

  include_dirs = [
    "${chip_root}/examples/all-clusters-app/all-clusters-common/include",
    "${chip_root}/examples/energy-management-app/energy-management-common/common/include",
    "${chip_root}/examples/energy-management-app/energy-management-common/device-energy-management/include",
    "${chip_root}/examples/energy-management-app/energy-management-common/energy-evse/include",
    "${chip_root}/examples/energy-management-app/energy-management-common/energy-reporting/include",
    "${chip_root}/examples/energy-management-app/energy-management-common/water-heater/include",
    "${chip_root}/examples/thermostat/thermostat-common/include",
  ]

  if (chip_enable_pw_rpc) {
    defines = rpc_defines
    sources += rpc_sources
    deps += rpc_deps

    deps += pw_build_LINK_DEPS

    include_dirs += [ "${chip_root}/examples/common" ]
  } else {
    # The system_rpc_server.cc file is in pigweed and doesn't compile with
    # -Wconversion, remove check for RPC build only.
    cflags = [ "-Wconversion" ]
  }

  if (chip_build_libshell) {
    defines = [ "ENABLE_CHIP_SHELL" ]
  }
}

source_set("chip-lock-app-common") {
  sources = [
    "${chip_root}/examples/lock-app/lock-common/include/LockEndpoint.h",
    "${chip_root}/examples/lock-app/lock-common/include/LockManager.h",
    "${chip_root}/examples/lock-app/lock-common/src/LockEndpoint.cpp",
    "${chip_root}/examples/lock-app/lock-common/src/LockManager.cpp",
    "${chip_root}/examples/lock-app/lock-common/src/ZCLDoorLockCallbacks.cpp",
  ]

  deps = [ "${chip_root}/examples/all-clusters-app/all-clusters-common" ]

  include_dirs = [ "${chip_root}/examples/lock-app/lock-common/include" ]

  cflags = [ "-Wconversion" ]
}

executable("certifier-all-clusters-app") {
  sources = [
    "../common/CertifierDACProvider.h",
    "../common/CertifierDACProvider.cpp",
    "LightingManager.h",
    "LightingManager.cpp",
    "CertifierOptions.h",
    "CertifierOptions.cpp",
    "main.cpp",
  ]

  include_dirs = [
    "../common",
    "${chip_root}/examples/all-clusters-app/all-clusters-common/include",
    "${chip_root}/examples/all-clusters-app/linux",
    "${root_out_dir}",
    "certifier/include",
    "certifier/internal_headers",
  ]

  deps = [
    ":trafficlight_copy",
    ":certifier-all-clusters-common",
    "${chip_root}/examples/platform/linux:app-main",
    "${chip_root}/src/credentials",
  ]

  cflags = [ "-Wconversion" ]

  lib_dirs = [ "." ]
  libs = [ "certifier" ]

  output_dir = root_out_dir
}

group("linux") {
  deps = []
  if (is_libfuzzer) {
    deps += [ ":certifier-all-clusters-app-fuzzing" ]
  } else {
    deps += [ ":certifier-all-clusters-app" ]
  }
}

group("default") {
  deps = [ ":linux" ]
}

if (enable_fuzz_test_targets) {
  chip_fuzz_target("fuzz-certifier-all-clusters-app") {
    sources = [ "fuzzing-main.cpp" ]
    public_deps = [
      ":certifier-all-clusters-common",
      "${chip_root}/examples/platform/linux:app-main",
    ]
  }
}
